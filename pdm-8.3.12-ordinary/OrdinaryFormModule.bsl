// Внешняя обработка «Консоль кода для PDM 8.3.12»
// Модуль обычной формы. Без управляемой формы, HTML и JavaScript.
//
// Элементы формы:
//   Код       — ПолеТекстовогоДокумента, многострочное;
//   Результат — ПолеТекстовогоДокумента, только просмотр;
//   Выполнить — Кнопка, Нажатие = ВыполнитьНажатие;
//   Очистить  — Кнопка, Нажатие = ОчиститьНажатие.
//
// Выполнение клиентское. Сообщить() выводит сообщения штатными средствами 1С.

Процедура ПриОткрытии()
    Если Не ЗначениеЗаполнено(ЭлементыФормы.Код.Значение) Тогда
        ЭлементыФормы.Код.Значение =
            "// Введите код 1С и нажмите «Выполнить».";
    КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьНажатие(Элемент)
    ТекстКода = ЭлементыФормы.Код.Значение;
    Если Не ЗначениеЗаполнено(ТекстКода) Тогда
        Предупреждение("Введите код для выполнения.");
        Возврат;
    КонецЕсли;

    НачалоВыполнения = ТекущаяДата();
    Попытка
        Выполнить(ТекстКода);
        ЭлементыФормы.Результат.Значение =
            "Выполнение завершено успешно." + Символы.ПС
            + "Начало: " + Формат(НачалоВыполнения, "ДФ=dd.MM.yyyy HH:mm:ss")
            + Символы.ПС
            + "Окончание: " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm:ss");
    Исключение
        ЭлементыФормы.Результат.Значение =
            "Ошибка выполнения:" + Символы.ПС + ОписаниеОшибки();
        Предупреждение(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ОчиститьНажатие(Элемент)
    ЭлементыФормы.Код.Значение = "";
    ЭлементыФормы.Результат.Значение = "";
КонецПроцедуры